{
  "name": "@qcard/host",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "run-cycle": "tsx src/cli.ts",
    "serve": "tsx src/serve.ts",
    "connect": "tsx src/pair.ts connect",
    "disconnect": "tsx src/pair.ts disconnect",
    "status": "tsx src/pair.ts status",
    "qcard": "tsx src/main.ts",
    "bundle": "pnpm --filter @qcard/web build && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node ../functions/scripts/emulators.mjs test 'vitest run'"
  },
  "dependencies": {
    "@qcard/agent": "workspace:*",
    "@qcard/apk": "workspace:*",
    "@qcard/data": "workspace:*",
    "@qcard/device": "workspace:*",
    "@qcard/fixtures": "workspace:*",
    "@qcard/llm": "workspace:*",
    "@qcard/qadoc": "workspace:*",
    "@qcard/shared": "workspace:*",
    "@qcard/spec": "workspace:*",
    "firebase": "13.0.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "24.19.0",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
