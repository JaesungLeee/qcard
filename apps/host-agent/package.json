    "@qcard/qadoc": "workspace:*",
    "@qcard/shared": "workspace:*",
    "@qcard/spec": "workspace:*",
    "firebase": "13.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "24.19.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
