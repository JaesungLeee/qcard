# 실제 Firebase(qcard-d2ade)로 빌드할 때: 이 파일을 apps/web/.env.production으로 복사하고 apiKey·appId를 채운다.
# 모두 브라우저에 노출되는 공개값이다. 비밀값(GitHub Client secret 등)은 넣지 않는다.
VITE_DATA=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=qcard-d2ade.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=qcard-d2ade
VITE_FIREBASE_STORAGE_BUCKET=qcard-d2ade.firebasestorage.app
VITE_FIREBASE_APP_ID=
