rules_version = '2';

// qcard Firestore 보안 규칙 (PRD §5.9, §8)
// - 읽기는 프로젝트 멤버만. 프로젝트 간 데이터는 서로 보이지 않는다
// - 프로젝트·멤버·초대 쓰기는 Cloud Functions(Admin SDK)만 한다 — "Admin 1명 이상", 초대 확인 같은
//   규칙은 @qcard/shared membership에 있고 Functions가 강제한다
// - QA 데이터 쓰기는 Admin·QA만, Viewer는 조회만 (F-TM-03)
// - 호스트 에이전트는 호스트 토큰(`host` 클레임)으로 접속한다. 그 연결(hostConnections)이 있는 동안만 통과한다 —
//   웹에서 연결을 해제하면 이미 받은 토큰으로도 읽기·쓰기가 바로 막힌다 (F-TM-14)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && hostOk();
    }
    function hostClaim() {
      return request.auth.token.get('host', null);
    }
    function connection(hostId) {
      return /databases/$(database)/documents/hostConnections/$(hostId);
    }
    // 사람이면 통과. 호스트면 연결이 살아 있고 이 사용자의 것이어야 한다
    function hostOk() {
      return hostClaim() == null
        || (exists(connection(hostClaim())) && get(connection(hostClaim())).data.uid == request.auth.uid);
    }
    function memberDoc(p) {
      return /databases/$(database)/documents/projects/$(p)/members/$(request.auth.uid);
    }
    function isMember(p) {
      return signedIn() && exists(memberDoc(p));
    }
    function role(p) {
      return get(memberDoc(p)).data.role;
    }
    function canEdit(p) {
      return isMember(p) && role(p) in ['admin', 'qa'];
    }

    // 사람 판정(decidedBy.kind == 'human')이 새로 생기거나 바뀌면, 이 요청에서 만든 로그(_decision)가 그 판정을 기록해야 한다
    function decisionLogged(p, c) {
      let next = request.resource.data;
      let human = next.get('decidedBy', {}).get('kind', '') == 'human';
      let unchanged = resource != null
        && resource.data.verdict == next.verdict
        && resource.data.get('decidedBy', null) == next.get('decidedBy', null)
        && resource.data.get('_decision', '') == next.get('_decision', '');
      return !human || unchanged || newLogMatches(p, c, next);
    }
    function newLogMatches(p, c, next) {
      let path = /databases/$(database)/documents/projects/$(p)/cycles/$(c)/verdictLog/$(next.get('_decision', '-'));
      let log = getAfter(path).data;
      return !exists(path) && existsAfter(path)
        && log.byUid == request.auth.uid
        && log.by == next.decidedBy.name
        && log.to == next.verdict
        && log.tcId == next.tcId
        && log.deviceId == next.deviceId;
    }

    match /projects/{p} {
      allow read: if isMember(p);
      allow write: if false;

      match /members/{uid} {
        allow read: if isMember(p);
        allow write: if false;
      }
      match /invitations/{id} {
        allow read: if isMember(p) && role(p) == 'admin';
        allow write: if false;
      }

      // QA 문서·케이스, 준비 플로우, 빌드, 테스트 사이클·Run·결과, 결함
      match /qaDocs/{rest=**} {
        allow read: if isMember(p);
        allow write: if canEdit(p);
      }
      match /prepFlows/{rest=**} {
        allow read: if isMember(p);
        allow write: if canEdit(p);
      }
      // 빌드: 올린 APK는 바꾸지 않는다 (모든 실행자가 같은 파일을 설치, F-DV-05)
      match /builds/{id} {
        allow read: if isMember(p);
        allow create: if canEdit(p);
        allow update, delete: if false;
      }
      // 테스트 사이클. 만들 때 고정한 스냅샷(TC ID·내용 해시)과 케이스 사본은 바꾸지 않는다 (F-CY-02)
      match /cycles/{c} {
        allow read: if isMember(p);
        allow create, delete: if canEdit(p);
        allow update: if canEdit(p)
          && request.resource.data.snapshot == resource.data.snapshot
          && request.resource.data.docId == resource.data.docId;
      }
      match /cycles/{c}/cases/{tcId} {
        allow read: if isMember(p);
        allow create: if canEdit(p);
        allow update, delete: if false;
      }
      // 판정 변경 이력 (F-RP-04): 판정자 = 로그인 사용자(프로필 이름), 시각 = 서버 시각. 남긴 뒤에는 바꾸지 못한다
      match /cycles/{c}/verdictLog/{id} {
        allow read: if isMember(p);
        allow create: if canEdit(p)
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.by == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
      // 결과 칸: 사람 판정으로 바꾸는 쓰기는 같은 요청에서 새 판정 로그를 남겨야 한다 (판정자·판정이 로그와 같다)
      match /cycles/{c}/results/{r} {
        allow read: if isMember(p);
        allow create, update: if canEdit(p) && decisionLogged(p, c);
        allow delete: if canEdit(p);
      }
      // 다시 실행해 밀려난 이전 시도 (F-CY-04): 보관만 하고 바꾸지 않는다
      match /cycles/{c}/attempts/{id} {
        allow read: if isMember(p);
        allow create: if canEdit(p);
        allow update, delete: if false;
      }
      // Run·결함 등 (cases·verdictLog·results·attempts는 위 규칙만 — 여기서 쓰기를 열지 않는다)
      match /cycles/{c}/{sub}/{rest=**} {
        allow read: if isMember(p);
        allow write: if canEdit(p) && !(sub in ['cases', 'verdictLog', 'results', 'attempts']);
      }
      match /defects/{rest=**} {
        allow read: if isMember(p);
        allow write: if canEdit(p);
      }
      // 스펙 묶음: 업로드한 버전 스냅샷 (F-IN-03). 만든 뒤에는 바꾸지 않는다
      match /specBundles/{id} {
        allow read: if isMember(p);
        allow create: if canEdit(p);
        allow update, delete: if false;
      }
      // QA 문서 생성 등 호스트 에이전트가 처리할 작업 (PRD §6.2). 요청자 본인 것만 만든다
      match /jobs/{id} {
        allow read: if isMember(p);
        allow create: if canEdit(p) && request.resource.data.requestedBy == request.auth.uid;
        allow update: if canEdit(p) && resource.data.requestedBy == request.auth.uid;
        allow delete: if false;
      }
    }

    // 내 멤버 문서 (컬렉션 그룹 조회로 "내 프로젝트 목록"을 만든다)
    // 질의 조건(where uid == 나)으로 증명할 수 있게 문서 id가 아니라 필드로 비교한다
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // 호스트 에이전트가 "내 작업"을 찾는다 (컬렉션 그룹 조회 where requestedBy == 나)
    match /{path=**}/jobs/{id} {
      allow read: if signedIn() && resource.data.requestedBy == request.auth.uid;
    }

    // 초대 토큰 → 초대 위치. Functions만 읽는다 (토큰을 모르는 사람이 초대를 찾지 못하게)
    match /invitationTokens/{token} {
      allow read, write: if false;
    }

    // 호스트 연결 (F-TM-14). Functions만 쓰고(pairHost·revokeHost), 본인은 "연결된 PC" 목록으로 읽는다
    // 질의 조건(where uid == 나)으로 증명할 수 있게 필드로 비교한다. 비밀값은 해시만 있다
    match /hostConnections/{hostId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // 사용자 프로필 (표시 이름·GitHub 사용자명). GitHub로 확인한 값만 Functions가 쓴다
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;

      // 내 호스트 에이전트 연결 신호 (그 호스트만 자기 문서를 갱신, 웹이 읽는다. 지우는 것은 연결 해제 때 Functions)
      match /hosts/{hostId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid && hostClaim() == hostId;
        allow delete: if false;
      }
    }
  }
}
