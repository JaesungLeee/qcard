rules_version = '2';

// qcard Cloud Storage 보안 규칙 — 스펙·빌드·증거(스크린샷·녹화)는 프로젝트 폴더 아래에 둔다
//   projects/{p}/cycles/{c}/runs/{run}/{tc}/obs-NN.png   (호스트가 올리는 Run 스크린샷)
//   projects/{p}/cycles/{c}/manual/{tc}__{device}/{id}.png  (사람이 올리는 수동 결과 첨부)
// 읽기는 멤버만, 쓰기는 Admin·QA만 (Firestore 멤버 문서를 본다). 프로젝트 간 증거는 서로 보이지 않는다.
// 호스트 토큰은 그 연결(hostConnections)이 있는 동안만 통과한다 (firestore.rules와 같은 규칙)
service firebase.storage {
  match /b/{bucket}/o {
    function member(p) {
      return /databases/(default)/documents/projects/$(p)/members/$(request.auth.uid);
    }
    function connection() {
      return /databases/(default)/documents/hostConnections/$(request.auth.token.host);
    }
    function signedIn() {
      return request.auth != null
        && (request.auth.token.get('host', null) == null
          || (firestore.exists(connection()) && firestore.get(connection()).data.uid == request.auth.uid));
    }

    // 빌드(APK)는 크다. 한 번 올린 파일은 덮어쓰지 않는다.
    // `create`만으로는 기존 파일 위 업로드가 막히지 않으므로 `resource == null`(아직 없는 파일)을 함께 본다
    match /projects/{p}/builds/{id}/{file} {
      allow read: if signedIn() && firestore.exists(member(p));
      allow create: if signedIn()
        && resource == null
        && firestore.exists(member(p))
        && firestore.get(member(p)).data.role in ['admin', 'qa']
        && request.resource.size < 300 * 1024 * 1024;
    }

    // 스크린샷: 그 Run을 실행한 사용자의 호스트만 올린다 (firestore.rules의 Run 규칙과 같다)
    match /projects/{p}/cycles/{c}/runs/{run}/{rest=**} {
      allow read: if signedIn() && firestore.exists(member(p));
      // 업로드 재시도로 같은 경로에 다시 쓸 수 있다
      allow write: if signedIn()
        && request.auth.token.get('host', null) != null
        && firestore.exists(member(p))
        && firestore.get(member(p)).data.role in ['admin', 'qa']
        && firestore.exists(/databases/(default)/documents/projects/$(p)/cycles/$(c)/runs/$(run))
        && firestore.get(/databases/(default)/documents/projects/$(p)/cycles/$(c)/runs/$(run)).data.get('executorUid', '') == request.auth.uid
        && request.resource.size < 20 * 1024 * 1024;
    }

    // 사람이 결과를 입력하며 첨부한 스크린샷: 웹에서 Admin·QA가 올린다. 한 번 올린 파일은 덮어쓰지 않는다.
    // 완료된 사이클도 사람 확정은 계속 되므로 막지 않고, 삭제 중인 사이클(deletingAt)만 막는다.
    // 형식·크기는 packages/data/src/logic.ts의 attachmentProblem과 같다
    match /projects/{p}/cycles/{c}/manual/{result}/{file} {
      allow read: if signedIn() && firestore.exists(member(p));
      allow create: if signedIn()
        && request.auth.token.get('host', null) == null
        && resource == null
        && firestore.exists(member(p))
        && firestore.get(member(p)).data.role in ['admin', 'qa']
        && firestore.exists(/databases/(default)/documents/projects/$(p)/cycles/$(c))
        && firestore.get(/databases/(default)/documents/projects/$(p)/cycles/$(c)).data.get('deletingAt', null) == null
        && request.resource.contentType.matches('image/(png|jpeg|webp)')
        && request.resource.size <= 10 * 1024 * 1024;
    }

    // 스펙 스냅샷은 변경 불가. 업로드마다 묶음 id가 새로 생기므로 덮어쓸 일이 없다
    match /projects/{p}/specBundles/{bundle}/{rest=**} {
      allow read: if signedIn() && firestore.exists(member(p));
      allow create: if signedIn()
        && resource == null
        && firestore.exists(member(p))
        && firestore.get(member(p)).data.role in ['admin', 'qa']
        && request.resource.size < 20 * 1024 * 1024;
    }

    // 그 밖의 프로젝트 파일. 빌드·사이클(Run 스크린샷)·스펙 경로는 위 규칙만 — 여기서 쓰기를 열지 않는다
    // (Storage는 맞는 규칙 중 하나만 허용해도 통과하므로, 여기서 빼지 않으면 빌드·스펙 덮어쓰기가 열린다)
    match /projects/{p}/{top}/{rest=**} {
      allow read: if signedIn() && firestore.exists(member(p));
      allow write: if signedIn()
        && !(top in ['builds', 'cycles', 'specBundles'])
        && firestore.exists(member(p))
        && firestore.get(member(p)).data.role in ['admin', 'qa']
        && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
