{
  "name": "qcard",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "verify": "turbo run typecheck test && node scripts/check-colors.mjs && node scripts/check-private-names.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "tokens": "pnpm --filter @qcard/ui tokens",
    "dev": "pnpm --filter @qcard/web dev",
    "dev:firebase": "pnpm --filter @qcard/web dev:firebase",
    "emu": "pnpm --filter @qcard/functions emulators",
    "ui:snap": "pnpm --filter @qcard/web ui:snap",
    "format": "prettier --write .",
    "device:record": "pnpm --filter @qcard/device record",
    "llm:smoke": "pnpm --filter @qcard/llm smoke",
    "device:check": "pnpm --filter @qcard/device check"
  },
  "devDependencies": {
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "prettier": "3.9.9"
  }
}
